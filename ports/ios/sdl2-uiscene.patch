+/* ---- UIScene lifecycle (see SDL_uikitappdelegate.h) ---- */
+
+static UIWindowScene *activeWindowScene API_AVAILABLE(ios(13.0), tvos(13.0)) = nil;
+
+UIWindowScene *
+UIKit_GetActiveWindowScene(void)
+{
+    if (activeWindowScene) {
+        return activeWindowScene;
+    }
+    /* whatever UIKit has connected, if asked before our delegate ran */
+    for (UIScene *scene in [UIApplication sharedApplication].connectedScenes) {
+        if ([scene isKindOfClass:[UIWindowScene class]]) {
+            return (UIWindowScene *)scene;
+        }
+    }
+    return nil;
+}
+
+UIWindow *
+UIKit_CreateSceneWindow(Class windowClass, CGRect frame)
+{
+    if (@available(iOS 13.0, tvOS 13.0, *)) {
+        UIWindowScene *scene = UIKit_GetActiveWindowScene();
+        if (scene) {
+            return [[windowClass alloc] initWithWindowScene:scene];
+        }
+    }
+    return [[windowClass alloc] initWithFrame:frame];
+}
+
+#if !TARGET_OS_TV
+UIInterfaceOrientation
+UIKit_GetInterfaceOrientation(void)
+{
+    if (@available(iOS 13.0, *)) {
+        UIWindowScene *scene = UIKit_GetActiveWindowScene();
+        if (scene) {
+            return scene.interfaceOrientation;
+        }
+    }
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    return [UIApplication sharedApplication].statusBarOrientation;
+#pragma clang diagnostic pop
+}
+#endif
+
+@implementation SDLUIKitSceneDelegate
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions
+{
+    if (![scene isKindOfClass:[UIWindowScene class]]) {
+        return;
+    }
+    activeWindowScene = (UIWindowScene *)scene;
+
+    SDLUIKitDelegate *appDelegate = [SDLUIKitDelegate sharedAppDelegate];
+    [appDelegate sceneDidConnect:activeWindowScene];
+
+    /* a URL that launched the app arrives here, not in -scene:openURLContexts: */
+    for (UIOpenURLContext *context in connectionOptions.URLContexts) {
+        [appDelegate sendDropFileForURL:context.URL];
+    }
+}
+
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    if (scene == activeWindowScene) {
+        activeWindowScene = nil;
+    }
+}
+
+- (void)sceneDidBecomeActive:(UIScene *)scene
+{
+    SDL_OnApplicationDidBecomeActive();
+}
+
+- (void)sceneWillResignActive:(UIScene *)scene
+{
+    SDL_OnApplicationWillResignActive();
+}
+
+- (void)sceneDidEnterBackground:(UIScene *)scene
+{
+    SDL_OnApplicationDidEnterBackground();
+}
+
+- (void)sceneWillEnterForeground:(UIScene *)scene
+{
+    SDL_OnApplicationWillEnterForeground();
+}
+
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)URLContexts
+{
+    SDLUIKitDelegate *appDelegate = [SDLUIKitDelegate sharedAppDelegate];
+    for (UIOpenURLContext *context in URLContexts) {
+        [appDelegate sendDropFileForURL:context.URL];
+    }
+}
+
+#if !TARGET_OS_TV
+/* replaces UIApplicationDidChangeStatusBarOrientationNotification, which is not sent with scenes */
+- (void)windowScene:(UIWindowScene *)windowScene
+didUpdateCoordinateSpace:(id<UICoordinateSpace>)previousCoordinateSpace
+interfaceOrientation:(UIInterfaceOrientation)previousInterfaceOrientation
+    traitCollection:(UITraitCollection *)previousTraitCollection
+{
+    if (windowScene.interfaceOrientation != previousInterfaceOrientation) {
+        SDL_OnApplicationDidChangeStatusBarOrientation();
+    }
+}
+#endif
+
+@end
+
 #endif /* SDL_VIDEO_DRIVER_UIKIT */
 
